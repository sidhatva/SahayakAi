# ==============================================================================
# Sahayak AI Environment Configuration Template
# Copy this file to .env and populate with your credentials.
# NEVER commit your actual .env file or service account credentials into git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Configuration (Firebase Web Client SDK)
# Obtain these values from:
# Firebase Console -> Project Settings -> General -> Your apps -> Web app (SDK setup and configuration)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=AIzaSyYourFirebaseWebApiKeyHere12345
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef0123456789

# ------------------------------------------------------------------------------
# 2. Backend Configuration (FastAPI & Firebase Admin SDK)
# For production server-side token verification:
# Generate a private service account key from:
# Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# Store the downloaded JSON securely on your server and point to its path:
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json

# Alternatively, set Google Application Credentials path:
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# ------------------------------------------------------------------------------
# 3. LLM & RAG Pipeline Configuration (FastAPI Backend)
# ------------------------------------------------------------------------------
# Google Gemini LLM Provider (Primary Grounded Generation)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Alternative OpenAI-Compatible Provider
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# RAG Retrieval Configuration
RAG_TOP_K=5
RAG_DISTANCE_THRESHOLD=0.40

